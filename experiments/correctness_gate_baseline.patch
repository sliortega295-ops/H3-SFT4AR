+def _unwrap_diagnostic_module(model):
+    candidate = model
+    visited = set()
+    while not hasattr(candidate, "_last_prediction_tensors"):
+        if id(candidate) in visited or not hasattr(candidate, "module"):
+            break
+        visited.add(id(candidate))
+        candidate = candidate.module
+    return candidate
+
+
+def _tensor_signature(tensor, sample_points=4096):
+    if tensor is None:
+        return None
+    flat = tensor.detach().reshape(-1)
+    numel = int(flat.numel())
+    if numel == 0:
+        return {"dtype": str(tensor.dtype), "shape": list(tensor.shape), "numel": 0}
+    if numel <= sample_points:
+        sampled = flat
+    else:
+        indices = (
+            torch.arange(sample_points, device=flat.device, dtype=torch.int64)
+            * (numel - 1)
+            // (sample_points - 1)
+        )
+        sampled = flat.index_select(0, indices)
+    sampled_cpu = sampled.float().cpu().contiguous()
+    full_float = flat.float()
+    return {
+        "dtype": str(tensor.dtype),
+        "shape": list(tensor.shape),
+        "numel": numel,
+        "sampled_sha256": hashlib.sha256(
+            sampled_cpu.numpy().tobytes()
+        ).hexdigest(),
+        "sum": float(full_float.sum(dtype=torch.float64).item()),
+        "sumsq": float((full_float * full_float).sum(dtype=torch.float64).item()),
+        "absmax": float(full_float.abs().max().item()),
+    }
+
+
+def _selected_trainable_parameters(model, count=3):
+    raw_model = _unwrap_diagnostic_module(model)
+    candidates = []
+    for name, parameter in raw_model.named_parameters():
+        if not parameter.requires_grad:
+            continue
+        full_numel = int(getattr(parameter, "ds_numel", parameter.numel()))
+        candidates.append((full_numel, name, parameter))
+    candidates.sort(key=lambda item: (-item[0], item[1]))
+    return [(name, parameter) for _, name, parameter in candidates[:count]]
+
+
+def _parameter_signatures(selected, kind):
+    try:
+        from deepspeed.utils import safe_get_local_fp32_param, safe_get_local_grad
+    except ImportError:
+        safe_get_local_fp32_param = safe_get_local_grad = None
+
+    signatures = {}
+    for name, parameter in selected:
+        if kind == "gradient":
+            tensor = (
+                safe_get_local_grad(parameter)
+                if safe_get_local_grad is not None
+                else parameter.grad
+            )
+        else:
+            tensor = (
+                safe_get_local_fp32_param(parameter)
+                if safe_get_local_fp32_param is not None
+                else parameter.data
+            )
+        signatures[name] = _tensor_signature(tensor)
+    return signatures
+
+
+def _prediction_signatures(model):
+    raw_model = _unwrap_diagnostic_module(model)
+    tensors = getattr(raw_model, "_last_prediction_tensors", None)
+    if tensors is None:
+        raise RuntimeError("Correctness capture did not observe model predictions.")
+    signatures = [_tensor_signature(tensor) for tensor in tensors]
+    raw_model._last_prediction_tensors = None
+    return signatures
+
+
+def _sample_identity(data):
+    def scalar(value):
+        if torch.is_tensor(value):
+            return int(value.detach().cpu().reshape(-1)[0].item())
+        return int(value)
+
+    return {"row_id": scalar(data["row_id"]), "chunk_id": scalar(data["chunk_id"])}
+
