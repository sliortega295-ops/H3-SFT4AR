+def _segment_bounds(cu_seqlens):
+    """Return host integer segment bounds, synchronizing at most once.
+
+    Optimized callers pass a tuple directly. The tensor fallback is retained for
+    API compatibility with the original inference/training call sites.
+    """
+
+    if isinstance(cu_seqlens, (tuple, list)):
+        return tuple(int(value) for value in cu_seqlens)
+    if not torch.is_tensor(cu_seqlens):
+        raise TypeError(f"Unsupported cu_seqlens type: {type(cu_seqlens)!r}")
+    if cu_seqlens.device.type != "cpu":
+        cu_seqlens = cu_seqlens.detach().to(device="cpu")
+    return tuple(int(value) for value in cu_seqlens.tolist())
