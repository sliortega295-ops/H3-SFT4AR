+def single_item_collate(batch):
+    """Preserve the original batch-size-one sample structure.
+
+    A top-level function is picklable under spawn-based DataLoader workers,
+    unlike the original inline lambda.
+    """
+
+    if len(batch) != 1:
+        raise ValueError(f"Expected DataLoader batch size 1, received {len(batch)} items.")
+    return batch[0]
+
+
+def _nvtx_range(enabled, name):
+    if not enabled or not torch.cuda.is_available():
+        return contextlib.nullcontext()
+
+    @contextlib.contextmanager
+    def _range():
+        torch.cuda.nvtx.range_push(name)
+        try:
+            yield
+        finally:
+            torch.cuda.nvtx.range_pop()
+
+    return _range()
+
+
+def _synchronize_for_benchmark(accelerator):
+    accelerator.wait_for_everyone()
+    if torch.cuda.is_available():
+        torch.cuda.synchronize(accelerator.device)
+
+
+def _write_benchmark_report(accelerator, output_path, elapsed, steps):
+    local = torch.tensor(
+        [float(elapsed), float(steps)],
+        dtype=torch.float64,
+        device=accelerator.device,
+    )
+    gathered = accelerator.gather(local).reshape(accelerator.num_processes, 2)
+    if not accelerator.is_main_process:
+        return
+
+    elapsed_values = gathered[:, 0].cpu()
+    measured_steps = int(gathered[0, 1].item())
+    max_elapsed = float(elapsed_values.max().item())
+    report = {
+        "measured_steps_per_rank": measured_steps,
+        "world_size": accelerator.num_processes,
+        "elapsed_seconds_mean_rank": float(elapsed_values.mean().item()),
+        "elapsed_seconds_max_rank": max_elapsed,
+        "steps_per_second": measured_steps / max_elapsed if max_elapsed > 0 else None,
+        "samples_per_second_global": (
+            measured_steps * accelerator.num_processes / max_elapsed
+            if max_elapsed > 0
+            else None
+        ),
+        "measurement_contract": (
+            "One synchronization before and after the complete window; no "
+            "per-phase synchronization is inserted. Includes data wait, forward, "
+            "backward, optimizer, scheduler, zero_grad, and logging for each step."
+        ),
+    }
+    print("H3 benchmark: " + json.dumps(report, ensure_ascii=False, sort_keys=True))
+    if output_path is not None:
+        os.makedirs(output_path, exist_ok=True)
+        report_path = os.path.join(output_path, "benchmark.json")
+        with open(report_path, "w", encoding="utf-8") as file:
+            json.dump(report, file, indent=2, ensure_ascii=False)
+        print(f"Benchmark report saved to `{report_path}`.")
+
+
+def _training_dataloader(dataset, num_workers, args):
+    pin_memory = bool(getattr(args, "dataloader_pin_memory", False))
+    persistent_workers = bool(
+        getattr(args, "dataloader_persistent_workers", False)
+    )
+    prefetch_factor = int(getattr(args, "dataloader_prefetch_factor", 2))
+    if prefetch_factor < 1:
+        raise ValueError("dataloader_prefetch_factor must be at least 1.")
+
+    kwargs = {
+        "dataset": dataset,
+        "shuffle": True,
+        "batch_size": 1,
+        "collate_fn": single_item_collate,
+        "num_workers": num_workers,
+        "pin_memory": pin_memory,
+    }
+    if num_workers > 0:
+        kwargs["persistent_workers"] = persistent_workers
+        kwargs["prefetch_factor"] = prefetch_factor
+    return torch.utils.data.DataLoader(**kwargs)
 
 
