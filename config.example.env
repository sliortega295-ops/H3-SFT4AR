# Required: your preprocessed MiniMax-H3 Ref2VA CSV.
CSV_PATH=/absolute/path/to/published_dynamic_segshots_v2_fps24_50_h3_preprocessed.csv

# Recommended: local MiniMax-H3 Ref2VA DiT shards (glob supported).
DIT_MODEL_PATH=/absolute/path/to/Ref2VA/transformer/model*.safetensors
MODEL_SPEC=MiniMax/MiniMax-H3:Ref2VA/transformer/model*.safetensors

# Optional: if your cluster already has a DiffSynth-Studio git checkout containing
# commit 6343deda..., set this to avoid cloning GitHub during bootstrap.
# DIFFSYNTH_SOURCE=/absolute/path/to/DiffSynth-Studio

SEED=20260820
WARMUP_STEPS=5
MEASURE_STEPS=30
DATASET_REPEAT=100
LEARNING_RATE=1e-5
MODES="baseline optimized-core optimized-data optimized-zero"

# Used only by optimized-data / optimized-zero.
DATA_WORKERS=2
PREFETCH_FACTOR=2
TEXT_CACHE_SIZE=64
PACKED_LAYOUT_CACHE_SIZE=64
# RESULT_ROOT=/absolute/path/to/results
